 <queryString language="SQL"><![CDATA[
 SELECT r.reservation_id, c.full_name AS customer_name, p.pet_name, p.breed, r.kennel_code, r.check_in, r.check_out, r.status, r.amount
 FROM reservations r JOIN customers c ON c.customer_id=r.customer_id JOIN pets p ON p.pet_id=r.pet_id ORDER BY r.check_in
 ]]></queryString>
